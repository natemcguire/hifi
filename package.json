{
  "name": "nsw-hifi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "dev": "npm run build && wrangler dev",
    "release": "node scripts/release-site.mjs",
    "mockup:live": "node scripts/build-youtube-mockup.mjs",
    "channel:build": "node channel/tools/build.mjs",
    "channel:stage": "node channel/tools/build.mjs && channel/tools/stage-pro.sh",
    "channel:test": "node --test channel/tools/test.mjs",
    "mockup:live:deploy": "node scripts/build-youtube-mockup.mjs && wrangler pages deploy dist-youtube-mockup --project-name hifi-mockups --branch youtube-live --commit-dirty=true"
  },
  "devDependencies": {
    "wrangler": "4.99.0"
  },
  "main": "index.html"
}
